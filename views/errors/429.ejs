<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="error-page">
    <div class="container">
      <span class="error-code">429</span>
      <h1 class="h2">Slow down a moment</h1>
      <p class="body-text"><%= message %></p>
      <p class="small-text">You can try again in about <%= retryAfter %> second<%= retryAfter === 1 ? '' : 's' %>.</p>
      <a href="/" class="btn btn-primary">Back to StageLink</a>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
