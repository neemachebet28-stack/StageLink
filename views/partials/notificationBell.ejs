<%
  // Reusable bell: pass { href } for the notification page appropriate to the
  // current shell (public, operator, driver). The unread count is filled in by
  // public/js/notifications.js from /api/notifications/unread-count.
  const bellHref = (typeof href !== 'undefined' && href) ? href : '/notifications';
%>
<a href="<%= bellHref %>" class="notif-bell" data-notif-bell aria-label="Notifications">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
    <path d="M13.7 21a2 2 0 0 1-3.4 0"/>
  </svg>
  <span class="notif-badge" data-notif-count hidden>0</span>
</a>
