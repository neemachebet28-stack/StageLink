<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);"><%= route.origin_stage_name %> &rarr; <%= route.destination_name %></h1>
        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <form class="op-form" method="post" action="/operator/routes/<%= route.id %>">
          <div class="op-field">
            <label for="name">Display name</label>
            <input type="text" id="name" name="name" value="<%= route.name || '' %>">
          </div>
          <div class="op-field">
            <label for="distanceKm">Distance (km)</label>
            <input type="number" id="distanceKm" name="distanceKm" step="0.1" min="0" value="<%= route.distance_km || '' %>">
          </div>
          <div class="op-field">
            <label for="durationMinutes">Typical duration (minutes)</label>
            <input type="number" id="durationMinutes" name="durationMinutes" min="0" value="<%= route.typical_duration_minutes || '' %>">
          </div>
          <div class="op-field">
            <label for="baseFareKes">Base fare (KES)</label>
            <input type="number" id="baseFareKes" name="baseFareKes" min="0" step="1" value="<%= route.base_fare_kes || '' %>">
          </div>
          <div class="op-field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="active" <%= route.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= route.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
