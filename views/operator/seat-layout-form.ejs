<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">New seat layout</h1>
        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <form class="op-form" method="post" action="/operator/seat-layouts">
          <div class="op-field">
            <label for="name">Layout name</label>
            <input type="text" id="name" name="name" placeholder="e.g. 14-Seater Standard" value="<%= formValues.name || '' %>" required>
          </div>
          <div class="op-field">
            <label for="totalSeats">Total seats</label>
            <input type="number" id="totalSeats" name="totalSeats" min="1" max="60" value="<%= formValues.totalSeats || '' %>" required>
            <p class="op-field-hint">Seats are generated automatically in rows of 4 (window, middle, middle, window).</p>
          </div>
          <button type="submit" class="btn btn-primary">Create layout</button>
        </form>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
