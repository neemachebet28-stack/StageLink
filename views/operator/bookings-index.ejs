<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Bookings</h1>
        <p class="lede">Every booking made with your organization.</p>
        <form method="get" style="margin-top: var(--space-4);">
          <select name="status" onchange="this.form.submit()" style="padding: 8px 12px; border-radius: var(--radius-input); border: 1px solid var(--color-border);">
            <option value="">All statuses</option>
            <% ['pending','confirmed','cancelled','expired','completed'].forEach(function (s) { %>
              <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }); %>
          </select>
        </form>
      </div>
    </section>
    <section style="padding-top: 0;">
      <div class="container">
        <% if (bookings.length === 0) { %>
          <div class="empty-state">No bookings match.</div>
        <% } else { %>
          <table class="op-table">
            <thead><tr><th>Reference</th><th>Passenger</th><th>Route</th><th>Seat</th><th>Departure</th><th>Fare</th><th>Status</th></tr></thead>
            <tbody>
              <% bookings.forEach(function (b) { %>
                <tr>
                  <td><%= b.booking_reference %></td>
                  <td><%= b.passenger_name %><br><span class="small-text"><%= b.passenger_phone %></span></td>
                  <td><%= b.origin_stage_name %> &rarr; <%= b.destination_name %></td>
                  <td><%= b.seat_number %></td>
                  <td><%= formatDateTime(b.scheduled_departure) %></td>
                  <td>KES <%= Number(b.fare_kes).toLocaleString() %></td>
                  <td><span class="badge badge-<%= b.status %>"><%= b.status.charAt(0).toUpperCase() + b.status.slice(1) %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
