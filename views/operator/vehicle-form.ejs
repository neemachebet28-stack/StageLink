<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);"><%= title %></h1>

        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <% if (layouts.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">
            You need a seat layout before adding a vehicle.
            <a href="/operator/seat-layouts/new" style="color: var(--color-primary); font-weight: 600;">Create one first</a>.
          </div>
        <% } else { %>
          <form class="op-form" method="post" action="<%= mode === 'create' ? '/operator/vehicles' : '/operator/vehicles/' + vehicle.id %>">
            <div class="op-field">
              <label for="registrationNumber">Registration number</label>
              <input type="text" id="registrationNumber" name="registrationNumber" value="<%= vehicle ? vehicle.registration_number : '' %>" <%= mode === 'edit' ? 'readonly' : 'required' %>>
            </div>
            <div class="op-field">
              <label for="seatLayoutId">Seat layout</label>
              <select id="seatLayoutId" name="seatLayoutId" required>
                <% layouts.forEach(function (l) { %>
                  <option value="<%= l.id %>" <%= vehicle && vehicle.seat_layout_id === l.id ? 'selected' : '' %>><%= l.name %> (<%= l.total_seats %> seats)</option>
                <% }); %>
              </select>
            </div>
            <div class="op-field">
              <label for="vehicleType">Vehicle type</label>
              <input type="text" id="vehicleType" name="vehicleType" placeholder="e.g. 14-seater matatu" value="<%= vehicle ? (vehicle.vehicle_type || '') : '' %>">
            </div>
            <div class="op-field">
              <label for="makeModel">Make / model</label>
              <input type="text" id="makeModel" name="makeModel" value="<%= vehicle ? (vehicle.make_model || '') : '' %>">
            </div>
            <% if (mode === 'edit') { %>
              <div class="op-field">
                <label for="status">Status</label>
                <select id="status" name="status">
                  <option value="active" <%= vehicle.status === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="maintenance" <%= vehicle.status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                  <option value="inactive" <%= vehicle.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
              </div>
            <% } %>
            <button type="submit" class="btn btn-primary"><%= mode === 'create' ? 'Add vehicle' : 'Save changes' %></button>
          </form>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
