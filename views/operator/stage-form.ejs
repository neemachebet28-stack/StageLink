<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Add a stage</h1>
        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <% if (available.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">You already serve every stage in the directory.</div>
        <% } else { %>
          <form class="op-form" method="post" action="/operator/stages">
            <div class="op-field">
              <label for="stageId">Stage</label>
              <select id="stageId" name="stageId" required>
                <option value="">Select a stage</option>
                <% available.forEach(function (s) { %>
                  <option value="<%= s.id %>"><%= s.name %> — <%= s.town_name %>, <%= s.county_name %></option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Add to my service area</button>
          </form>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
