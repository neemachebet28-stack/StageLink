<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Settings</h1>
        <p class="lede">Your organization's public profile.</p>

        <% if (success) { %>
          <div class="empty-state" style="margin-top: var(--space-6); border-color: var(--color-primary); color: var(--color-primary);">Saved.</div>
        <% } %>
        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <p class="small-text" style="margin-top: var(--space-6);">
          Verification status: <span class="badge badge-<%= organization.verification_status %>"><%= organization.verification_status.charAt(0).toUpperCase() + organization.verification_status.slice(1) %></span>
          — set by StageLink admins, not editable here.
        </p>

        <form class="op-form" method="post" action="/operator/settings">
          <div class="op-field">
            <label for="name">Organization name</label>
            <input type="text" id="name" name="name" value="<%= organization.name %>" required>
          </div>
          <div class="op-field">
            <label for="description">Description</label>
            <input type="text" id="description" name="description" value="<%= organization.description || '' %>">
          </div>
          <div class="op-field">
            <label for="contactEmail">Contact email</label>
            <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email || '' %>">
          </div>
          <div class="op-field">
            <label for="contactPhone">Contact phone</label>
            <input type="text" id="contactPhone" name="contactPhone" value="<%= organization.contact_phone || '' %>">
          </div>
          <div class="op-field">
            <label for="logoUrl">Logo URL</label>
            <input type="text" id="logoUrl" name="logoUrl" value="<%= organization.logo_url || '' %>">
          </div>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
