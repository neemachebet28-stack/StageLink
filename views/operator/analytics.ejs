<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Analytics</h1>
        <p class="lede">Computed live from your own bookings and payments — nothing here is a placeholder number.</p>

        <div class="op-stats">
          <div class="op-stat-card"><div class="op-stat-value"><%= metrics.seatsSold %></div><div class="op-stat-label">Seats sold (confirmed)</div></div>
          <div class="op-stat-card"><div class="op-stat-value">KES <%= metrics.revenueKes.toLocaleString() %></div><div class="op-stat-label">Total revenue (paid)</div></div>
          <div class="op-stat-card"><div class="op-stat-value"><%= metrics.activeTrips %></div><div class="op-stat-label">Active trips</div></div>
        </div>
      </div>
    </section>

    <section style="padding-top: 0;">
      <div class="container">
        <h2 class="h2">Bookings, last 14 days</h2>
        <% if (bookingsByDay.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">No confirmed bookings in this period.</div>
        <% } else { %>
          <table class="op-table">
            <thead><tr><th>Date</th><th>Bookings</th><th>Revenue</th></tr></thead>
            <tbody>
              <% bookingsByDay.forEach(function (d) { %>
                <tr><td><%= d.day %></td><td><%= d.bookings %></td><td>KES <%= Number(d.revenue_kes).toLocaleString() %></td></tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="h2">Revenue by route</h2>
        <% if (revenueByRoute.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">No confirmed bookings yet.</div>
        <% } else { %>
          <table class="op-table">
            <thead><tr><th>Route</th><th>Bookings</th><th>Revenue</th></tr></thead>
            <tbody>
              <% revenueByRoute.forEach(function (r) { %>
                <tr><td><%= r.origin_stage_name %> &rarr; <%= r.destination_name %></td><td><%= r.bookings %></td><td>KES <%= Number(r.revenue_kes).toLocaleString() %></td></tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
