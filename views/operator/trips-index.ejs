<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container">
        <div class="op-toolbar" style="margin-top: 0;">
          <div>
            <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Trips</h1>
            <p class="lede">Every trip for <%= currentUser.organizationName %>.</p>
          </div>
          <a href="/operator/trips/new" class="btn btn-primary">New trip</a>
        </div>
      </div>
    </section>

    <section style="padding-top: 0;">
      <div class="container">
        <% if (trips.length === 0) { %>
          <div class="empty-state">No trips yet. Create your first one.</div>
        <% } else { %>
          <table class="op-table">
            <thead>
              <tr>
                <th>Route</th>
                <th>Scheduled</th>
                <th>Vehicle</th>
                <th>Driver</th>
                <th>Seats</th>
                <th>Fare</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% trips.forEach(function (trip) { %>
                <tr>
                  <td><%= trip.origin_stage_name %> &rarr; <%= trip.destination_name %></td>
                  <td><%= formatDateTime(trip.scheduled_departure) %></td>
                  <td><%= trip.registration_number %></td>
                  <td><%= trip.driver_name || '—' %></td>
                  <td><%= trip.total_seats - trip.available_seats %> / <%= trip.total_seats %></td>
                  <td>KES <%= Number(trip.fare_kes).toLocaleString() %></td>
                  <td><span class="badge badge-<%= trip.status %>"><%= trip.status.charAt(0).toUpperCase() + trip.status.slice(1) %></span></td>
                  <td><a href="/operator/trips/<%= trip.id %>/edit">Manage</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
