<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/operatorHeader') %>

  <main class="op-main">
    <section class="page-header">
      <div class="container">
        <div class="op-toolbar" style="margin-top: 0;">
          <div>
            <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Vehicles</h1>
            <p class="lede">Your fleet.</p>
          </div>
          <a href="/operator/vehicles/new" class="btn btn-primary">New vehicle</a>
        </div>
      </div>
    </section>

    <section style="padding-top: 0;">
      <div class="container">
        <% if (vehicles.length === 0) { %>
          <div class="empty-state">No vehicles yet.</div>
        <% } else { %>
          <table class="op-table">
            <thead><tr><th>Registration</th><th>Type</th><th>Make/Model</th><th>Seat layout</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% vehicles.forEach(function (v) { %>
                <tr>
                  <td><%= v.registration_number %></td>
                  <td><%= v.vehicle_type || '—' %></td>
                  <td><%= v.make_model || '—' %></td>
                  <td><%= v.seat_layout_name %> (<%= v.total_seats %> seats)</td>
                  <td><span class="badge badge-<%= v.status === 'active' ? 'boarding' : 'expired' %>"><%= v.status.charAt(0).toUpperCase() + v.status.slice(1) %></span></td>
                  <td><a href="/operator/vehicles/<%= v.id %>/edit">Manage</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
