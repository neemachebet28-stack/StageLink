<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container" style="max-width: 560px;">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/trips/<%= trip.id %>">Seat selection</a>
          <span class="sep">/</span>
          <span>Booking summary</span>
        </nav>
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Booking summary</h1>
        <p class="lede"><%= trip.origin_stage_name %> &rarr; <%= trip.destination_name %> · <%= trip.organization_name %></p>
        <%- include('../partials/trustBadge', { status: trip.verification_status, explain: true, summary: { count: trip.review_count, average: trip.review_average } }) %>

        <% if (error) { %>
          <div class="op-error" style="margin-top: var(--space-6);"><%= error %></div>
        <% } %>

        <% if (holds.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">
            You don't have any held seats for this trip right now — holds expire after a few
            minutes. <a href="/trips/<%= trip.id %>" style="color: var(--color-primary); font-weight: 600;">Go back and select a seat</a>.
          </div>
        <% } else { %>
          <div class="list-rows" style="margin-top: var(--space-6);" data-holds-list data-trip-id="<%= trip.id %>">
            <% holds.forEach(function (h) { %>
              <div class="summary-line">
                <span>Seat <%= h.seat_number %> (<%= h.seat_type %>)</span>
                <span>KES <%= Number(trip.fare_kes).toLocaleString() %></span>
              </div>
            <% }); %>
            <div class="summary-total">
              <span>Total</span>
              <span>KES <%= (holds.length * Number(trip.fare_kes)).toLocaleString() %></span>
            </div>
          </div>

          <p class="small-text" style="margin-top: var(--space-3);" data-summary-timer>
            Your hold expires soon — complete this form before it does.
          </p>

          <form class="op-form" method="post" action="/trips/<%= trip.id %>/bookings" data-checkout-form>
            <div class="op-field">
              <label for="passengerName">Full name</label>
              <input type="text" id="passengerName" name="passengerName" value="<%= passengerName %>" required>
            </div>
            <div class="op-field">
              <label for="passengerPhone">Phone number</label>
              <input type="tel" id="passengerPhone" name="passengerPhone" value="<%= passengerPhone %>" placeholder="+254 7xx xxx xxx" required>
            </div>
            <p class="small-text">
              Payment isn't part of StageLink yet — this confirms your seat reservation. You'll
              see a booking reference next.
            </p>
            <button type="submit" class="btn btn-primary" data-submit-button>Confirm booking</button>
          </form>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
