<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/discover">Discover</a>
          <span class="sep">/</span>
          <a href="/stages/<%= route.origin_stage_id %>"><%= route.origin_stage_name %></a>
          <span class="sep">/</span>
          <span><%= route.destination_name %></span>
        </nav>
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">
          <%= route.origin_stage_name %> &rarr; <%= route.destination_name %>
        </h1>
        <p class="lede">
          Operated by <a href="/operators/<%= route.organization_id %>" style="color: var(--color-primary); font-weight: 600;"><%= route.organization_name %></a>
          <span class="badge badge-<%= route.verification_status %>" style="margin-left: 8px;">
            <%= route.verification_status.charAt(0).toUpperCase() + route.verification_status.slice(1) %>
          </span>
        </p>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="list-rows" style="max-width: 640px;">
          <div class="list-row">
            <div class="list-row-title">Origin stage</div>
            <div class="list-row-meta"><%= route.origin_stage_name %>, <%= route.origin_town_name %>, <%= route.origin_county_name %></div>
          </div>
          <div class="list-row">
            <div class="list-row-title">Destination</div>
            <div class="list-row-meta"><%= route.destination_name %></div>
          </div>
          <% if (route.distance_km) { %>
            <div class="list-row">
              <div class="list-row-title">Distance</div>
              <div class="list-row-meta"><%= Number(route.distance_km).toLocaleString() %> km</div>
            </div>
          <% } %>
          <% if (route.typical_duration_minutes) { %>
            <div class="list-row">
              <div class="list-row-title">Typical duration</div>
              <div class="list-row-meta">~<%= Math.round(route.typical_duration_minutes / 60 * 10) / 10 %> hours</div>
            </div>
          <% } %>
          <% if (route.base_fare_kes) { %>
            <div class="list-row">
              <div class="list-row-title">Base fare</div>
              <div class="list-row-meta">KES <%= Number(route.base_fare_kes).toLocaleString() %></div>
            </div>
          <% } %>
        </div>

      </div>
    </section>

    <section>
      <div class="container">
        <h2 class="h2">Available trips</h2>
        <p class="body-text" style="margin-top: 8px;">
          Real trip instances from <%= route.organization_name %>, with live seat counts.
          Booking a seat is arriving in a later phase.
        </p>

        <% if (trips.length === 0) { %>
          <div class="empty-state" style="margin-top: var(--space-6);">
            No trips are currently scheduled on this route.
          </div>
        <% } else { %>
          <div class="trip-cards">
            <% trips.forEach(function (trip) { %>
              <%- include('../partials/tripCard', { trip }) %>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
