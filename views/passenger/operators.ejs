<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Operators</h1>
        <p class="lede">Transport operators on StageLink, with their real verification status.</p>

        <form class="search-form" action="/operators" method="get">
          <input class="search-input" type="search" name="q" value="<%= search %>" placeholder="Search operators" aria-label="Search operators">
          <button type="submit" class="btn btn-primary">Search</button>
        </form>
      </div>
    </section>

    <section>
      <div class="container">
        <% if (operators.length === 0) { %>
          <div class="empty-state">
            <% if (search) { %>
              No operators match "<%= search %>".
            <% } else { %>
              No operators are listed yet.
            <% } %>
          </div>
        <% } else { %>
          <div class="entity-grid">
            <% operators.forEach(function (op) { %>
              <a class="entity-card" href="/operators/<%= op.id %>">
                <div style="display:flex; align-items:center; justify-content:space-between; gap: var(--space-3);">
                  <div class="entity-card-title"><%= op.name %></div>
                  <span class="badge badge-<%= op.verification_status %>">
                    <%= op.verification_status.charAt(0).toUpperCase() + op.verification_status.slice(1) %>
                  </span>
                </div>
                <div class="entity-card-meta">
                  <%= op.stage_count %> stage<%= op.stage_count === 1 ? '' : 's' %> · <%= op.route_count %> route<%= op.route_count === 1 ? '' : 's' %>
                </div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
