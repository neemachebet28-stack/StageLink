<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container" style="max-width: 640px;">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Group &amp; event transport</h1>
        <p class="lede">Tell us what you need — operators will send you quotations to compare.</p>

        <% if (error) { %><div class="op-error" style="margin-top: var(--space-6);"><%= error %></div><% } %>

        <form class="op-form" method="post" action="/group-trips">
          <div class="op-field">
            <label for="passengerCount">Number of passengers</label>
            <input type="number" id="passengerCount" name="passengerCount" min="1" value="<%= formValues.passengerCount || '' %>" required>
          </div>
          <div class="op-field">
            <label for="originText">Origin</label>
            <input type="text" id="originText" name="originText" placeholder="e.g. Nairobi CBD, XYZ School" value="<%= formValues.originText || '' %>" required>
          </div>
          <div class="op-field">
            <label for="originCountyId">Origin county <span class="small-text">(optional, helps operators find your request)</span></label>
            <select id="originCountyId" name="originCountyId">
              <option value="">Not specified</option>
              <% counties.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
            </select>
          </div>
          <div class="op-field">
            <label for="destinationText">Destination</label>
            <input type="text" id="destinationText" name="destinationText" placeholder="e.g. Naivasha, Lake View Resort" value="<%= formValues.destinationText || '' %>" required>
          </div>
          <div class="op-field">
            <label for="destinationCountyId">Destination county <span class="small-text">(optional)</span></label>
            <select id="destinationCountyId" name="destinationCountyId">
              <option value="">Not specified</option>
              <% counties.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
            </select>
          </div>
          <div class="op-field">
            <label for="travelDate">Travel date</label>
            <input type="date" id="travelDate" name="travelDate" required>
          </div>
          <div class="op-field">
            <label for="departureTime">Departure time <span class="small-text">(optional)</span></label>
            <input type="time" id="departureTime" name="departureTime">
          </div>
          <div class="op-field">
            <label for="returnDate">Return date <span class="small-text">(optional, for round trips)</span></label>
            <input type="date" id="returnDate" name="returnDate">
          </div>
          <div class="op-field">
            <label for="returnTime">Return time <span class="small-text">(optional)</span></label>
            <input type="time" id="returnTime" name="returnTime">
          </div>
          <div class="op-field">
            <label for="vehicleRequirements">Vehicle requirements <span class="small-text">(optional)</span></label>
            <input type="text" id="vehicleRequirements" name="vehicleRequirements" placeholder="e.g. 33-seater with AC">
          </div>
          <div class="op-field">
            <label for="budgetKes">Budget (KES) <span class="small-text">(optional)</span></label>
            <input type="number" id="budgetKes" name="budgetKes" min="0" step="1">
          </div>
          <div class="op-field">
            <label for="passengerName">Your name</label>
            <input type="text" id="passengerName" name="passengerName" value="<%= formValues.passengerName || '' %>" required>
          </div>
          <div class="op-field">
            <label for="passengerPhone">Your phone</label>
            <input type="text" id="passengerPhone" name="passengerPhone" placeholder="+254 7xx xxx xxx" value="<%= formValues.passengerPhone || '' %>" required>
          </div>
          <div class="op-field">
            <label for="passengerEmail">Email <span class="small-text">(optional)</span></label>
            <input type="email" id="passengerEmail" name="passengerEmail">
          </div>
          <div class="op-field">
            <label for="notes">Additional notes <span class="small-text">(optional)</span></label>
            <input type="text" id="notes" name="notes">
          </div>
          <button type="submit" class="btn btn-primary">Submit request</button>
        </form>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
