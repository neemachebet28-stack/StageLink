<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/discover">Discover</a>
          <span class="sep">/</span>
          <a href="/stages/<%= stage.id %>"><%= stage.name %></a>
          <span class="sep">/</span>
          <span><%= operator.name %></span>
        </nav>
        <div style="display:flex; align-items:center; gap: var(--space-4); flex-wrap: wrap;">
          <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);"><%= operator.name %></h1>
          <span class="badge badge-<%= operator.verification_status %>">
            <%= operator.verification_status.charAt(0).toUpperCase() + operator.verification_status.slice(1) %>
          </span>
        </div>
        <p class="lede">Destinations <%= operator.name %> serves from <%= stage.name %>.</p>
      </div>
    </section>

    <section>
      <div class="container">
        <% if (destinations.length === 0) { %>
          <div class="empty-state">
            <%= operator.name %> doesn't currently list any destinations from this stage.
          </div>
        <% } else { %>
          <div class="list-rows">
            <% destinations.forEach(function (d) { %>
              <a class="list-row" href="/routes/<%= d.id %>">
                <div>
                  <div class="list-row-title"><%= d.destination_name %></div>
                  <% if (d.typical_duration_minutes) { %>
                    <div class="list-row-meta">~<%= Math.round(d.typical_duration_minutes / 60 * 10) / 10 %> hrs</div>
                  <% } %>
                </div>
                <% if (d.base_fare_kes) { %>
                  <div class="list-row-action">KES <%= Number(d.base_fare_kes).toLocaleString() %></div>
                <% } %>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
