<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);">Destinations</h1>
        <p class="lede">Everywhere StageLink operators currently run routes to.</p>

        <form class="search-form" action="/destinations" method="get">
          <input class="search-input" type="search" name="q" value="<%= search %>" placeholder="Search destinations" aria-label="Search destinations">
          <button type="submit" class="btn btn-primary">Search</button>
        </form>
      </div>
    </section>

    <section>
      <div class="container">
        <% if (destinations.length === 0) { %>
          <div class="empty-state">
            <% if (search) { %>
              No destinations match "<%= search %>".
            <% } else { %>
              No destinations are listed yet.
            <% } %>
          </div>
        <% } else { %>
          <div class="entity-grid">
            <% destinations.forEach(function (d) { %>
              <a class="entity-card" href="/destinations/<%= d.id %>">
                <div class="entity-card-title"><%= d.name %></div>
                <div class="entity-card-meta"><%= d.county_name %> County · <%= d.route_count %> route<%= d.route_count === 1 ? '' : 's' %></div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
