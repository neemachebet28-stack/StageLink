<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <section class="page-header">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/discover">Discover</a>
          <span class="sep">/</span>
          <span><%= county.name %></span>
        </nav>
        <h1 class="h1" style="font-size: clamp(1.9rem, 1.6rem + 1.4vw, 2.6rem);"><%= county.name %> County</h1>
        <p class="lede">Towns with listed stages in <%= county.name %>.</p>

        <form class="search-form" action="/discover/counties/<%= county.id %>" method="get">
          <input
            class="search-input"
            type="search"
            name="q"
            value="<%= search %>"
            placeholder="Search towns in <%= county.name %>"
            aria-label="Search towns"
          >
          <button type="submit" class="btn btn-primary">Search</button>
        </form>
      </div>
    </section>

    <section>
      <div class="container">
        <% if (towns.length === 0) { %>
          <div class="empty-state">
            <% if (search) { %>
              No towns in <%= county.name %> match "<%= search %>".
            <% } else { %>
              No towns are listed for <%= county.name %> yet.
            <% } %>
          </div>
        <% } else { %>
          <div class="entity-grid">
            <% towns.forEach(function (town) { %>
              <a class="entity-card" href="/discover/towns/<%= town.id %>">
                <div class="entity-card-title"><%= town.name %></div>
                <div class="entity-card-meta"><%= town.stage_count %> stage<%= town.stage_count === 1 ? '' : 's' %></div>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
